---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Review Manager">
  <div class="flex min-h-screen items-center justify-center bg-slate-50 px-6">
    <div class="w-full max-w-md rounded-xl border border-slate-200 bg-white p-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-slate-400">404</p>
      <h1 class="mt-2 text-2xl font-bold text-slate-900">Page not found</h1>
      <p class="mt-2 text-sm text-slate-500">That address does not exist, or the page has moved.</p>
      <a href="/dashboard" class="mt-6 inline-flex items-center justify-center rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800">Go to the dashboard</a>
    </div>
  </div>
</Layout>
