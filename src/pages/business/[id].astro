---
import Layout from '../../layouts/Layout.astro';
import BusinessDetail from '../../components/BusinessDetail';
import NotificationsBell from '../../components/NotificationsBell';
import { verifySession } from '../../lib/auth';

const cookie = Astro.cookies.get("admin_session")?.value;
const user = await verifySession(cookie);

if (!user) {
  return Astro.redirect("/login");
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect("/dashboard");
}
---

<Layout title="Business Reviews | Review Management System">
  <div class="min-h-screen bg-[#F8FAFC] font-sans">
    <header class="sticky top-0 z-50 border-b border-slate-200/60 bg-white/80 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 sm:px-8">
        <a href="/dashboard" class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#EE314F] text-white shadow-lg shadow-[#EE314F]/20">
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
          </div>
          <div>
            <h1 class="text-xl font-bold tracking-tight text-slate-900">Review Manager</h1>
            <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Webspires Systems</p>
          </div>
        </a>
        <NotificationsBell client:load />
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-6 py-10 sm:px-8">
      <BusinessDetail client:load locationId={id} />
    </main>
  </div>
</Layout>
